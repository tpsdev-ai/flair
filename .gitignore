node_modules/
dist/
.flair/
.DS_Store
package-lock.json
*.gguf
# Harper writes this placeholder while a model downloads; a killed run leaves
# it behind as an untracked file (flair#1066). *.gguf does not cover it.
*.gguf.downloading
resources/*.js
# Build-time vendored copy of the descriptor source (flair#1683). Generated by
# scripts/vendor-tool-descriptors.mjs; source of truth is packages/flair-tool-descriptors/src/index.ts.
resources/tool-descriptors/
packages/flair-mcp/src/tool-descriptors/
test-results/
playwright-report/
test/e2e/screenshots/
packages/**/__pycache__/
plugins/**/*.pyc
.pytest_cache/

# Disposable hero-mock / screenshot artifacts (not shipped)
ui/_shoot*.mjs
ui/floor-*.png
ui/hero-*.png
ui/office-space*.html

# Environment files — never tracked (contain secrets or are service-manager config)
.env
.env.*
!.env.example
.venv/
