{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/cli.ts",
    "src/cli-shim.cts",
    "src/postinstall.cts",
    "src/fabric-npm-install.ts",
    "src/stamp-migration-verify.ts",
    "src/stamp-outstanding.ts"
  ],
  "exclude": ["node_modules", "test"]
}
