{
  "name": "@tpsdev-ai/flair",
  "version": "0.59.0",
  "packageManager": "bun@1.4.2",
  "description": "Identity, memory, and soul for AI agents. Cryptographic identity (Ed25519), semantic memory with local embeddings, and persistent personality — all in a single process.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tpsdev-ai/flair.git"
  },
  "homepage": "https://github.com/tpsdev-ai/flair",
  "bugs": {
    "url": "https://github.com/tpsdev-ai/flair/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "identity",
    "memory",
    "semantic-search",
    "embeddings",
    "ed25519",
    "harper",
    "llm",
    "openclaw"
  ],
  "main": "./dist/resources/in-process-api.js",
  "exports": {
    ".": "./dist/resources/in-process-api.js",
    "./server": "./dist/resources/in-process.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "flair": "dist/cli-shim.cjs"
  },
  "files": [
    "dist/",
    "schemas/",
    "templates/",
    "docs/",
    "config.yaml",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean && node scripts/vendor-tool-descriptors.mjs",
    "build": "tsc -p tsconfig.json --noCheck && node scripts/write-build-info.mjs",
    "build:cli": "tsc -p tsconfig.cli.json --noCheck && node scripts/write-build-info.mjs",
    "prepack": "npm run build && npm run build:cli",
    "test": "bun run test:unit",
    "test:unit": "bun scripts/test-unit.ts",
    "test:e2e": "playwright test",
    "release": "./scripts/release.sh",
    "postinstall": "node -e \"try{require('./dist/postinstall.cjs')}catch(e){}\""
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "v26.10.0"
  },
  "dependencies": {
    "@harperfast/oauth": "2.9.0",
    "@types/js-yaml": "4.0.9",
    "commander": "14.0.3",
    "harper": "5.3.1",
    "harper-fabric-embeddings": "0.5.0",
    "jose": "6.2.12",
    "js-yaml": "4.3.2",
    "semver": "7.8.5",
    "tar": "7.5.22",
    "tweetnacl": "1.0.3"
  },
  "overrides": {
    "react-native-fs": "npm:empty-npm-package@1.0.0",
    "brace-expansion": "5.0.12",
    "undici": "8.10.2",
    "fast-uri": "4.2.1",
    "hono": "4.13.13",
    "js-yaml": "4.3.2",
    "adm-zip": "0.6.1",
    "@opentelemetry/core": "2.11.0",
    "uuid": "11.1.1",
    "tar": "7.5.22",
    "@tootallnate/once": "2.0.1",
    "form-data": "4.0.6",
    "mysql2": "3.24.5",
    "mariadb": "3.4.7",
    "qs": "6.16.0",
    "fastify": "5.12.5",
    "lodash": "4.18.1",
    "ip-address": "10.7.3",
    "joi": "17.13.8",
    "moment": "2.31.0",
    "@grpc/grpc-js": "1.14.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/semver": "7.8.0",
    "@types/tar": "7.0.87",
    "bun-types": "1.4.2",
    "typescript": "5.9.3"
  },
  "trustedDependencies": [
    "harper-fabric-embeddings"
  ],
  "workspaces": [
    "packages/*"
  ]
}
