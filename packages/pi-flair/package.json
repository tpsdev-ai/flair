{
  "name": "@tpsdev-ai/pi-flair",
  "version": "0.59.0",
  "description": "Flair memory extension for pi — persistent memory access from within pi sessions",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "v26.10.0"
  },
  "dependencies": {
    "@tpsdev-ai/flair-client": "0.59.0",
    "@sinclair/typebox": "0.34.52"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tpsdev-ai/flair.git",
    "directory": "packages/pi-flair"
  },
  "homepage": "https://tps.dev/#flair",
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "flair",
    "memory",
    "semantic-search",
    "ai",
    "agent"
  ],
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "24.19.0",
    "typescript": "5.9.3"
  }
}
