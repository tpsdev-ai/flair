# Environment configuration template.
# Copy this file to .env and fill in values as needed.
#
# IMPORTANT: env-based config is NOT read under service managers (launchd, systemd).
# The launchd/systemd plists set environment variables directly.
# This file is only useful for local development run via `flair start` or `bun run`.
# See flair#824 for details.

FLAIR_ADMIN_AGENTS=
